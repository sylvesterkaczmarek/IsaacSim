set(PACKAGE_VERSION "@ISAACSIM_CONFIG_PACKAGE_VERSION@")

if(NOT PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    return()
endif()

# CMake's find_package version argument cannot express PEP 440 suffixes. Refuse
# numeric version requests for prerelease, post, development, and local builds;
# unversioned discovery still exposes the full package version in <group>_VERSION.
if(NOT "@ISAACSIM_CONFIG_PACKAGE_VERSION@" STREQUAL "@ISAACSIM_CONFIG_PACKAGE_RELEASE_VERSION@")
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
    return()
endif()

if(NOT PACKAGE_FIND_VERSION_MAJOR EQUAL @ISAACSIM_CONFIG_PACKAGE_MAJOR@
   OR NOT PACKAGE_FIND_VERSION_MINOR EQUAL @ISAACSIM_CONFIG_PACKAGE_MINOR@
)
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
elseif(PACKAGE_FIND_VERSION VERSION_GREATER "@ISAACSIM_CONFIG_PACKAGE_RELEASE_VERSION@")
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
endif()

if(PACKAGE_FIND_VERSION STREQUAL "@ISAACSIM_CONFIG_PACKAGE_RELEASE_VERSION@")
    set(PACKAGE_VERSION_EXACT TRUE)
endif()
