import subprocess
import sys

MODULES = [
@INSTALL_CONTRACT_PYTHON_MODULES@]

for module in MODULES:
    subprocess.run(
        [
            sys.executable,
            "-c",
            (
                "import importlib, pathlib; "
                f"package = importlib.import_module({module!r}); "
                "package_dir = pathlib.Path(package.__file__).parent; "
                "assert (package_dir / 'py.typed').is_file(); "
                "installed = tuple(package_dir.rglob('*')); "
                "forbidden_dirs = {'tests', '__pycache__', '.pytest_cache', '.mypy_cache'}; "
                "assert not any(path.name in forbidden_dirs for path in installed); "
                "assert not any(path.suffix in {'.pyc', '.pyo'} for path in installed); "
                "assert not any(path.is_symlink() for path in installed)"
            ),
        ],
        check=True,
    )
